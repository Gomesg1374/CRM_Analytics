# Copie este arquivo para .env na raiz do projeto e preencha os valores.
# O arquivo .env é carregado por scheduler/run_etl.ps1 antes de executar o ETL.
# NUNCA faça commit do .env (ele já está no .gitignore).

# ──────────────────────────────────────────────
# PostgreSQL (etl/load.py)
# ──────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DB=crm_analytics
PG_USER=crm
PG_PASS=crm123

# ──────────────────────────────────────────────
# Notificação por e-mail em caso de falha (F4.2)
# Use uma conta Gmail com autenticação em 2 etapas ativada.
# Gere a senha de app em: myaccount.google.com/apppasswords
# ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_app_gmail
NOTIFY_TO=seu_email@exemplo.com
